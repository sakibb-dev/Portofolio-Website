# ---- Supabase (Project Settings → API Keys) ----
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxx.supabase.co
# Publishable key (sb_publishable_…) atau anon key lama
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Secret key (sb_secret_…) atau service_role key lama. RAHASIA: hanya di server.
SUPABASE_SECRET_KEY=

# ---- Admin tunggal: harus sama dengan baris di tabel public.admins ----
ADMIN_EMAIL=

# ---- Resend (notifikasi pesan baru) ----
RESEND_API_KEY=
# Pengirim dari domain yang sudah diverifikasi di Resend, atau onboarding@resend.dev untuk uji coba
RESEND_FROM="Portofolio <onboarding@resend.dev>"

# ---- URL publik situs (untuk Open Graph), tanpa garis miring akhir ----
NEXT_PUBLIC_SITE_URL=https://domainmu.vercel.app
